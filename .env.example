# ============================= DB =============================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_rag

# ============================= LLM =============================
# mock | openai | (any OpenAI-compatible provider via LLM_BASE_URL)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ============================= Embeddings =============================
# mock | openai | local
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
# Determines vector width and enables Matryoshka (MRL) truncation for openai.
EMBEDDING_DIMENSION=1536

# ============================= OpenAI =============================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MISTRAL_API_KEY=

# ============================= Retrieval / rerank =============================
# linear | (any reranking provider)
RERANK_PROVIDER=linear
RERANK_MODEL=BAAI/bge-reranker-v2-m3
TOP_K=4
RRV_K=60
RETRIEVAL_TIMEOUT_SECONDS=30

# ============================= Semantic cache =============================
ENABLE_SEMANTIC_CACHE=false
CACHE_SIMILARITY_THRESHOLD=0.95

# ============================= API security / rate limit =============================
API_AUTH_ENABLED=false
API_AUTH_TOKEN=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD_SECONDS=60

# ============================= Guardrails / retrieval =============================
CLOUD_REGION=eu-west-3
SIMILARITY_THRESHOLD=0.75
MAX_EXECUTION_STEPS=5
GUARDRAIL_STRICT_MODE=true

# ============================= Observability / audit =============================
TRACE_ENABLED=true
AUDIT_LOG_ENABLED=true